---
import Base from "../../layouts/Base.astro";
import PageHead from "../PageHead.astro";
import StopTimes from "../StopTimes.astro";
import Faq from "../Faq.astro";
import Related from "../Related.astro";
import { dict, fill, pathFor, type Lang } from "../../lib/i18n";
import { fareText, first, route } from "../../lib/routes";
import { TRIPS, slugOf, type TripKey } from "../../lib/pages";
import { pageCopy, pageVars, AIRPORT } from "../../lib/content";
import { breadcrumbLd, faqLd, webPageLd } from "../../lib/seo";

interface Props { lang: Lang; trip: TripKey }
const { lang, trip } = Astro.props;
const d = dict(lang);
const p1 = route("P1");
const c = pageCopy(trip, lang) as ReturnType<typeof pageCopy> & Record<string, string>;
const v = pageVars(trip, lang);
const slug = slugOf(trip);
const cfg = TRIPS[trip];
const facts = [
  { label: d.ui.fare, value: fareText(p1, lang) },
  { label: d.ui.boarding, value: d.routes.P1.boarding },
  { label: d.ui.travelTime, value: String(v.destTime) },
  { label: `${d.ui.first} / ${d.ui.last}`, value: `${first(p1, "outbound")} – ${v.p1last}` },
];
---
<Base
  lang={lang}
  slug={slug}
  title={c.title}
  description={c.description}
  jsonld={[webPageLd(lang, slug, c.title, c.description, p1.lastVerified), breadcrumbLd(lang, slug, c.h1), faqLd(c.faq)]}
>
  <PageHead lang={lang} h1={c.h1} intro={c.intro} checked={p1.lastVerified} />

  <section class="wrap pb-8">
    <dl class="grid sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-ink">
      {facts.map((f) => (
        <div class="border-r border-b border-ink p-4 bg-paper-tint flex flex-col">
          <dt class="label">{f.label}</dt>
          <dd class="mt-1 text-lg leading-snug">{f.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-ink-soft">{d.routes.P1.liveGps}</p>
  </section>

  <section class="wrap pb-6 grid lg:grid-cols-2 gap-x-8">
    <StopTimes route={p1} lang={lang} dir="outbound" title={d.trip.outTitle} only={[AIRPORT, ...cfg.to]} />
    <StopTimes route={p1} lang={lang} dir="inbound" title={d.trip.backTitle} only={[...cfg.back, AIRPORT]} />
  </section>

  <section class="wrap pb-4 max-w-3xl">
    <h2 class="label mb-2">⟁ {d.trip.otherTitle}</h2>
    <p class="text-ink-soft text-lg leading-snug">{fill(c.other, v)}</p>
    <p class="mt-3"><a class="u" href={pathFor(lang, p1.slug)}>P1 · {d.routes.P1.name}</a> · <a class="u" href={pathFor(lang, slugOf("airport"))}>{d.nav.airport}</a></p>
  </section>

  <Faq lang={lang} faq={c.faq} />
  <Related lang={lang} current={trip} />
</Base>
