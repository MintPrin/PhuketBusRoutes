---
import { dict, fill, pathFor, type Lang } from "../lib/i18n";
import {
  fareText, first, last, inboundStops, mapsUrl, stopAlt, stopName, type Route,
} from "../lib/routes";

interface Props { route: Route; lang: Lang; level?: "h2" | "h3"; link?: boolean }
const { route: r, lang, level = "h3", link = false } = Astro.props;
const d = dict(lang);
const rt = d.routes[r.id] as Record<string, string>;
const H = level;
const payLabel = d.payment as Record<string, string>;

// Yellow header needs dark text; the others take paper text.
const darkText = r.id === "P4";
const viaAirport = !!r.airport;
const dirs = (["outbound", "inbound"] as const).filter((k) => r.schedules[k]);
const stopsFor = (k: "outbound" | "inbound") => (k === "outbound" ? r.stops : inboundStops(r));
const endName = (k: "outbound" | "inbound") => {
  const s = stopsFor(k);
  return stopName(s[s.length - 1], lang);
};
const dirLabel = (k: "outbound" | "inbound") =>
  viaAirport ? (k === "outbound" ? d.ui.fromAirport : d.ui.toAirport) : fill(d.ui.toPlace, { place: endName(k) });
const noteFor = (k: "outbound" | "inbound") => (k === "outbound" ? rt.noteOut : rt.noteIn) ?? (dirs.length ? undefined : rt.note);
---
<article id={r.id} data-route={r.id} class="relative bg-paper border border-ink/85 shadow-paper scroll-mt-28">
  <header class:list={["px-5 md:px-8 py-5 md:py-6 border-b border-ink/85", darkText ? "text-ink" : "text-paper"]} style={`background:${r.color}`}>
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div class="flex items-baseline gap-4">
        <div class="font-display text-5xl md:text-6xl leading-none" style="font-family:'Instrument Serif',Georgia,serif">{r.id}</div>
        <div>
          <H class="font-display italic text-xl md:text-2xl leading-tight">
            {link ? <a href={pathFor(lang, r.slug)} class="hover:underline">{rt.name}</a> : rt.name}
          </H>
          <div class="font-mono text-[0.68rem] uppercase tracking-[0.2em] opacity-85 mt-1">{rt.summary}</div>
        </div>
      </div>
      <div class="font-mono text-[0.7rem] uppercase tracking-[0.2em] border border-current/40 px-3 py-1.5 rounded-sm">
        {d.ui.fare}: {fareText(r, lang)}
      </div>
    </div>
  </header>

  {dirs.length > 1 && (
    <div class="px-5 md:px-8 pt-5 flex justify-end">
      <div class="inline-flex border border-ink rounded-sm overflow-hidden font-mono text-[0.68rem] uppercase tracking-[0.18em]" role="group">
        {dirs.map((k, i) => (
          <button type="button" data-dir-btn={k} aria-pressed={i === 0 ? "true" : "false"} class="px-3 py-1.5 aria-pressed:bg-ink aria-pressed:text-paper hover:bg-ink/10">
            {dirLabel(k)}
          </button>
        ))}
      </div>
    </div>
  )}

  {(dirs.length ? dirs : (["outbound"] as const)).map((k, i) => {
    const stops = stopsFor(k);
    const times = r.schedules[k]?.times ?? [];
    const note = noteFor(k);
    return (
      <div data-dir-panel={k} hidden={i > 0} class="grid lg:grid-cols-12 gap-x-8 gap-y-10 p-5 md:p-8">
        <div class="lg:col-span-5">
          <div class="flex items-center justify-between mb-3">
            <div class="label">⟁ {d.ui.stops} · {stops.length}</div>
          </div>
          <ol class="relative">
            <span aria-hidden="true" class="absolute left-[14px] top-2 bottom-2 w-[2px]" style={`background:${r.color}`}></span>
            {stops.map((s, idx) => (
              <li class="relative pl-12 py-1.5">
                <span aria-hidden="true" class="absolute left-[8px] top-[12px] w-[14px] h-[14px] rounded-full border-2 border-paper" style={`background:${r.color};box-shadow:0 0 0 2px ${r.color}`}></span>
                <a href={mapsUrl(s)} target="_blank" rel="nofollow noopener" class="group block">
                  <span class="font-mono text-[0.62rem] text-ink-mute tabular-nums mr-2">{String(idx + 1).padStart(2, "0")}</span>
                  <span class="font-medium group-hover:text-vermillion">{stopName(s, lang)}</span>
                  <span class="block text-xs text-ink-mute ml-7">{stopAlt(s, lang)}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="mt-3 text-xs text-ink-mute">{d.ui.tapStop}</p>
        </div>

        <div class="lg:col-span-7">
          <div class="label mb-3">⟁ {d.ui.departures} · {stopName(stops[0], lang)}</div>
          {r.frequency ? (
            <div class="border border-ink bg-paper-tint p-6">
              <div class="font-display text-4xl md:text-5xl leading-none">{fill(d.ui.every, { n: r.frequency.every })}</div>
              <div class="font-mono text-2xl mt-3 tabular-nums">{fill(d.ui.hours, { start: r.frequency.start, end: r.frequency.end })}</div>
            </div>
          ) : times.length ? (
            <>
              <ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 border-t border-l border-ink">
                {times.map((t) => (
                  <li class="bg-paper-tint border-r border-b border-ink/40 py-2.5 text-center font-mono text-lg md:text-xl tabular-nums">{t}</li>
                ))}
              </ul>
              <div class="mt-2 label">{fill(d.ui.departuresCount, { n: times.length })} · {d.ui.first} {first(r, k)} · {d.ui.last} {last(r, k)}</div>
            </>
          ) : (
            <p class="border border-dashed border-ink/40 p-6 text-ink-mute">{d.ui.notPosted}</p>
          )}
          {note && <p class="mt-4 text-sm text-ink-soft leading-snug border-l-2 border-vermillion pl-3">{note}</p>}
          {k === "outbound" && r.flags?.includes("lastBusConflict") && (
            <p class="mt-3 text-sm text-ink-soft leading-snug border-l-2 border-vermillion pl-3">⚠ {rt.lastBusConflict}</p>
          )}
        </div>
      </div>
    );
  })}

  <footer class="border-t border-ink/85 bg-paper-tint px-5 md:px-8 py-4 grid grid-cols-12 gap-y-3 gap-x-6">
    <div class="col-span-12 md:col-span-5">
      <div class="label">{d.ui.payment}</div>
      <div class="mt-1 flex flex-wrap gap-1.5">
        {r.payment.map((p) => <span class="font-mono text-[0.66rem] uppercase tracking-[0.12em] border border-ink/60 px-2 py-0.5 rounded-sm">{payLabel[p]}</span>)}
      </div>
    </div>
    <div class="col-span-12 md:col-span-4">
      <div class="label">{d.ui.operator}</div>
      <div class="mt-1 text-sm">{r.operator}{r.facebook && <> · <a class="u" href={r.facebook} target="_blank" rel="nofollow noopener">{d.ui.operatorPage}</a></>}</div>
    </div>
    <div class="col-span-12 md:col-span-3 md:text-right">
      <div class="label">{d.ui.checked}</div>
      <div class="mt-1 font-mono text-sm tabular-nums">{r.lastVerified}</div>
    </div>
  </footer>
</article>

<script>
  // Direction toggle: both directions are in the HTML; this only swaps which panel shows.
  document.querySelectorAll<HTMLElement>("article[data-route]").forEach((card) => {
    const btns = card.querySelectorAll<HTMLButtonElement>("[data-dir-btn]");
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        card.querySelectorAll<HTMLElement>("[data-dir-panel]").forEach((p) => {
          p.hidden = p.dataset.dirPanel !== b.dataset.dirBtn;
        });
      }),
    );
  });
</script>
