{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "phuketbusroutes.mintprin.com"
        }
      ],
      "destination": "https://phuketbusroutes.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.phuketbusroutes.com"
        }
      ],
      "destination": "https://phuketbusroutes.com/:path*",
      "permanent": true
    }
  ]
}
